# All keys are optional here — every one of them can also be pasted in the app's
# Settings page instead, where they are stored in the local SQLite DB (data/parak.db,
# gitignored). Env vars take precedence over Settings.

# Answers (pick one provider)
# Anthropic Claude — best quality. https://console.anthropic.com/
ANTHROPIC_API_KEY=
# …or any OpenAI-compatible endpoint (OpenAI, Groq, Gemini, NVIDIA, OpenRouter, Ollama…)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Live transcription (recommended — free credits at https://console.deepgram.com/)
DEEPGRAM_API_KEY=

# Where the SQLite database lives (default: ./data/parak.db)
# PARAK_DB_PATH=
